:root {
}

.bag-button {
    width: 60px;
    height: 60px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    margin-top: 2px;
    margin-right: 4px;
    margin-bottom: 2px;
    margin-left: 4px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.bag-button:hover {
    -unity-background-image-tint-color: rgba(255, 215, 0, 0.5);
}

.slot {
    width: 60px;
    height: 60px;
    background-image: url("project://database/Assets/Images/inv_potion_51.jpg?fileID=2800000&guid=f8f337d0739d24121a2b01a8342de091&type=3#inv_potion_51");
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.slot:hover {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(138, 185, 255, 0.5);
    border-right-color: rgba(138, 185, 255, 0.5);
    border-top-color: rgba(138, 185, 255, 0.5);
    border-bottom-color: rgba(138, 185, 255, 0.5);
}

.slot:active {
    -unity-background-image-tint-color: rgba(255, 255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.collection {
    flex-wrap: wrap-reverse;
    flex-direction: row-reverse;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
}

.bag {
    flex-grow: 0;
    width: 253px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: rgb(55, 49, 31);
}

.bag-top {
    flex-grow: 1;
    height: 47px;
}

.bag-label {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    flex-grow: 1;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-definition: resource("Fonts/friz-quadrata-regular-os-5870333951e7c SDF");
    border-left-color: rgb(164, 164, 164);
    border-right-color: rgb(164, 164, 164);
    border-top-color: rgb(164, 164, 164);
    border-bottom-color: rgb(164, 164, 164);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.top-spacing {
    flex-grow: 1;
}

.close {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 25px;
    height: 25px;
    border-left-color: rgb(164, 164, 164);
    border-right-color: rgb(164, 164, 164);
    border-top-color: rgb(164, 164, 164);
    border-bottom-color: rgb(164, 164, 164);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: rgb(87, 11, 0);
    -unity-font-definition: resource("Fonts/friz-quadrata-regular-os-5870333951e7c SDF");
    color: rgb(255, 185, 0);
    font-size: 21px;
    -unity-text-align: middle-center;
}

.header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: flex-end;
}

.bag-icon {
    flex-grow: 0;
    background-image: url("project://database/Assets/Images/inv_misc_bag_08.jpg?fileID=2800000&guid=85c04af3f65854ff6a620e0902f8fde9&type=3#inv_misc_bag_08");
    aspect-ratio: 1;
    border-top-left-radius: 82px;
    border-top-right-radius: 82px;
    border-bottom-right-radius: 82px;
    border-bottom-left-radius: 82px;
    height: 60px;
    left: -10px;
    top: -10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.yellow-border {
    border-left-color: #FFEB04;
    border-right-color: #FFEB04;
    border-top-color: #FFEB04;
    border-bottom-color: #FFEB04;
}